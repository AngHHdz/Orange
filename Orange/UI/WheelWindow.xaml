<Window x:Class="Orange.UI.WheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orange Wheel"
        Width="400" Height="430"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        AllowDrop="True">
    <Grid x:Name="Root" Opacity="0" RenderTransformOrigin="0.5,0.46">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Zoom" ScaleX="0.85" ScaleY="0.85" />
        </Grid.RenderTransform>

        <!-- Wheel: 400×400 area; slices are drawn in code. -->
        <Canvas x:Name="Ring" Width="400" Height="400" VerticalAlignment="Top">
            <Canvas.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" />
            </Canvas.Effect>
        </Canvas>

        <!-- Center: shows what will happen, or "Cancel". -->
        <Border Width="124" Height="124" CornerRadius="62" VerticalAlignment="Top" Margin="0,138,0,0"
                Background="#F2141416" BorderBrush="#33FFFFFF" BorderThickness="1" IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="CenterTitle" Text="Convert" HorizontalAlignment="Center"
                           Foreground="{StaticResource OrangeAccent}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="CenterSub" Text="drop on a slice" HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="#A0FFFFFF" FontSize="11" Margin="8,2,8,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Mode bar under the wheel. -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#E61E1E22"
                CornerRadius="14" Padding="6,4" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TabConvert" Text="Shift · Convert" Margin="8,2" FontSize="12" />
                <TextBlock x:Name="TabTools" Text="Ctrl · Tools" Margin="8,2" FontSize="12" />
                <TextBlock x:Name="TabActions" Text="Alt · Actions" Margin="8,2" FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
